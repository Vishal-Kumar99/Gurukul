<UserControl x:Class="Gurukul.Components.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gurukul.Components"
             xmlns:convert="clr-namespace:Gurukul.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--<core:BoolToAngleConverter x:Key="BoolToAngleConverter"/>-->
        <convert:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <convert:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <convert:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidthConverter"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.ColumnSpan="3" Margin="12 0 0 0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>

                                <!-- Chevron -->
                                <TextBlock x:Name="Chevron"
                                           Grid.Column="2"
                                           Text="❯"
                                           FontSize="14"
                                           Margin="12 0"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ChevronRotate"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333"/>
                            </Trigger>

                            <!-- Rotate Chevron -->
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ChevronRotate"
                                                Storyboard.TargetProperty="Angle"
                                                To="90"
                                                Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ChevronRotate"
                                                Storyboard.TargetProperty="Angle"
                                                To="0"
                                                Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSubButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Padding" Value="40,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="HamburgerButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#1E1E1E">
        <Border.Width>
            <Binding Path="IsCollapsed" Converter="{StaticResource BoolToSidebarWidthConverter}"/>
        </Border.Width>

        <StackPanel>
            <Grid Height="56" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Gurukul" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>

                <Button Grid.Column="1"
                        Content="☰"
                        Style="{StaticResource HamburgerButtonStyle}"
                        Command="{Binding ToggleSidebarCommand}">
                    <!--<TextBlock Text="☰" 
                               FontSize="18" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>-->
                </Button>
            </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!--MAIN ITEM-->
                            <Button Command="{Binding ToggleCommand}" 
                                    CommandParameter="{Binding RelativeSource={RelativeSource self}}" 
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Background="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}" >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>
                                        <!--<Image Source="{Binding Icon}" 
                                               Width="20" 
                                               Height="20" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>-->

                                        <TextBlock Text="{Binding Title}"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                                    </Grid>
                            </Button>

                            <!--SUB ITEMS-->
                            <Border Margin="10 0 0 0" 
                                    Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibilityConverter}}" 
                                    Background="#252525">
                                <ItemsControl ItemsSource="{Binding Options}" 
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}"
                                                    Command="{Binding DataContext.SubItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SidebarSubButtonStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <Popup IsOpen="{Binding IsFlyoutOpen}"
                   Placement="Right"
                   PlacementTarget="{Binding PopupTarget}"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Background="#2A2A2A"
                        Padding="8"
                        CornerRadius="6"
                        MinWidth="180">
                    <ItemsControl ItemsSource="{Binding FlyoutItem.Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.SubItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SidebarSubButtonStyle}"/>
                                <!--<Button Content="{Binding Title}"
                                        Height="36"
                                        Foreground="White"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Padding="12 0"/>-->
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </StackPanel>
    </Border>
</UserControl>
