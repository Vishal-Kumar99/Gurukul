<UserControl x:Class="Gurukul.MVVM.Views.AddClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gurukul.MVVM.Views"
             mc:Ignorable="d" 
             Background="#F3F4F6"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Border Margin="30"
            Padding="25"
            Background="White"
            CornerRadius="16" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Class Management"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,20" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                
                <GroupBox Header="Existing Classes" Margin="0 0 20 0">
                    <ListView ItemsSource="{Binding SortedSectionView}" 
                            SelectedItem="{Binding SelectedSection}" 
                            MinHeight="300" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Class Name" 
                                            DisplayMemberBinding="{Binding ClassName}" 
                                            Width="150"/>
                                <GridViewColumn Header="Section"
                                            DisplayMemberBinding="{Binding SectionName}" 
                                            Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <StackPanel Grid.Column="1">
                    <GroupBox Header="Add New Class">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                            
                            <TextBlock Text="Class Name:" 
                                       Width="100" 
                                       Style="{StaticResource MutedText}"/>
                            
                            <ComboBox IsEditable="True" 
                                      IsTextSearchEnabled="True" 
                                      Width="160" 
                                      Text="{Binding NewClassName, UpdateSourceTrigger=PropertyChanged}" 
                                      ItemsSource="{Binding SortedClassView}" 
                                      DisplayMemberPath="ClassName"/>
                            
                            <Button Content="Add" 
                                    Width="90" 
                                    HorizontalAlignment="Center" 
                                    Margin="20,0,0,0" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddClassCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Add New Section">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <TextBlock Text="Class:" Width="60" Style="{StaticResource MutedText}"/>
                            
                            <ComboBox Width="140"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      ItemsSource="{Binding SortedClassView}"
                                      SelectedItem="{Binding SelectedClass}"
                                      SelectedValuePath="ClassId"
                                      DisplayMemberPath="ClassName"/>

                            <TextBlock Text="Section:" Width="70" Margin="15 0 0 0" Style="{StaticResource MutedText}"/>

                            <ComboBox IsEditable="True" 
                                      IsTextSearchEnabled="True" 
                                      Width="120" 
                                      Text="{Binding NewSectionName, UpdateSourceTrigger=PropertyChanged}" 
                                      ItemsSource="{Binding UniqueSectionList}" />
                            
                            <Button Content="Add" 
                                    Width="90" 
                                    Margin="20,0,0,0" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddSectionCommand}"/>
                        </StackPanel>
                    </GroupBox>

                    <Border Background="#FEF2F2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Danger Zone"
                                       FontWeight="Bold"
                                       Foreground="#991B1B"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Delete Selected" Width="140"
                                    Command="{Binding DeleteSectionCommand}"
                                    Style="{StaticResource DangerButtonStyle}"/>

                                <TextBlock Text="⚠ This will delete all related data"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#991B1B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
