<UserControl x:Class="Gurukul.MVVM.Views.Admission.Steps.AddressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gurukul.MVVM.Views.Admission.Steps"
             mc:Ignorable="d" 
             Background="#F3F4F6"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Width="400">

            <!-- Address -->
            <TextBlock Text="Address" />
            <TextBox Text="{Binding AddressLine, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="60"/>

            <!-- City -->
            <TextBlock Text="City" Margin="0,10,0,0"/>
            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />

            <!-- State -->
            <TextBlock Text="State" Margin="0,10,0,0"/>
            <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Pincode -->
            <TextBlock Text="Pincode" Margin="0,10,0,0"/>
            <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="6"/>

            <!-- Landmark -->
            <TextBlock Text="Landmark (optional)" Margin="0,10,0,0"/>
            <TextBox Text="{Binding Landmark, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Validation Errors -->
            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Red" FontSize="12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
