<UserControl x:Class="Gurukul.MVVM.Views.Admission.Steps.HealthDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gurukul.MVVM.Views.Admission.Steps"
             mc:Ignorable="d" 
             Background="#F3F4F6"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Width="400">

            <!-- Blood Group -->
            <TextBlock Text="Blood Group" />
            <ComboBox ItemsSource="{Binding BloodGroups}"
                      SelectedItem="{Binding BloodGroup}"
                      IsEditable="False" />

            <!-- Medical Condition -->
            <TextBlock Text="Medical Condition (if any)" Margin="0,10,0,0"/>
            <TextBox Text="{Binding MedicalCondition, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Allergy -->
            <TextBlock Text="Allergy Details (if any)" Margin="0,10,0,0"/>
            <TextBox Text="{Binding AllergyDetails, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Disability -->
            <CheckBox Content="Student has any physical disability"
                      IsChecked="{Binding HasDisability}"
                      Margin="0,10,0,0"/>

            <!-- Validation Errors -->
            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Red" FontSize="12"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
